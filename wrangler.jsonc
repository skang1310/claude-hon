{
  "name": "claude-hon",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RANK", "class_name": "Rank" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Rank"] }]
}
